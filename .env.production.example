# Variables de entorno requeridas en Vercel (Project Settings > Environment
# Variables) para el deploy de producción. Este archivo solo documenta las
# claves — nunca pongas valores reales acá, es el único .env* que SÍ se
# commitea (ver excepción en .gitignore).

# Postgres de Supabase. En producción (Vercel) no aplica la limitación de
# puertos bloqueados que sí afectó al desarrollo local (ver CLAUDE.md, Fase
# 0.1) — puede usarse la misma URL del Session Pooler.
DATABASE_URL=

# Secreto de NextAuth para firmar JWT/sesiones. Genera uno nuevo para
# producción (no reuses el de desarrollo): `openssl rand -base64 32`.
NEXTAUTH_SECRET=

# URL pública real de producción, NO localhost — ej. https://vetcloud.vercel.app
# Si se deja en localhost, el login y los callbacks de NextAuth se rompen.
NEXTAUTH_URL=

# Supabase Storage — declaradas desde la Fase 0 para el logo de clínica /
# fotos de mascota (Clinica.logoUrl, Paciente.fotoUrl en el schema), pero
# ninguna fase construyó todavía la subida de archivos: hoy no hay ningún
# `process.env.NEXT_PUBLIC_SUPABASE_*` ni `SUPABASE_SERVICE_ROLE_KEY` en el
# código de la app (confirmado por búsqueda en app/ y lib/). Se documentan
# igual porque el schema ya las anticipa y porque no cuesta nada tenerlas
# cargadas en Vercel para cuando se implemente Storage — pero no son
# necesarias para que el deploy actual funcione.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
